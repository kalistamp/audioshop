# Generated by `npm run setup`. The phone sends it with every request; keep it out of public/.
AUDIOSHOP_TOKEN=
# Folder of the voice-reader project (the text-to-speech engine). Your voice files and model
# weights stay there and are never copied into this repository.
VOICE_READER_HOME=
# The HTTPS address your phone uses to reach this machine, e.g. from `tailscale serve`.
PUBLIC_URL=
# Sites allowed to call this server from a browser (comma-separated). Same-origin always works.
ALLOWED_ORIGINS=https://kalistamp.github.io
# Optional
PORT=8787
HOST=127.0.0.1
MAX_WORDS=20000
MAX_UPLOAD_MB=30
KEEP_DAYS=30
KEEP_JOBS=100
